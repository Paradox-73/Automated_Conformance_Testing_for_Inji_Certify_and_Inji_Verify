# Local machine files, secrets and run state (never in git)
local.properties
*.log
.env
.env.local
*.jks
*.keystore
*.p12
*.pem.private
secrets/
# Runtime state of the harness (default HARNESS_RUN_DIR). Anchored to the repository root so that a source
# folder named "run" anywhere else is still committed.
/run/
