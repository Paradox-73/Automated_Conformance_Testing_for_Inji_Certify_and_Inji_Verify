{#- Shared parts of summary.html and diff.html.

    Icons are SVG symbols defined once per page and drawn with <use>. Each verdict has an icon of its own shape, and
    every use of an icon is followed by the verdict as a word, so colour is never the only signal. The icons are
    aria-hidden: the word is what a screen reader reads.
-#}
{% macro icon_sprite() %}
<svg class="visually-hidden" aria-hidden="true">
  <symbol id="i-conforms" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7.5" fill="currentColor"/><path d="M4.4 8.3l2.4 2.5 4.8-5.3" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-gap" viewBox="0 0 16 16"><path d="M8 .8l7.6 14H.4z" fill="currentColor"/><path d="M8 5.6v4.6" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/><circle cx="8" cy="12.4" r="1" fill="#fff"/></symbol>
  <symbol id="i-regression" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7.5" fill="currentColor"/><path d="M5.2 5.2l5.6 5.6M10.8 5.2l-5.6 5.6" stroke="#fff" stroke-width="1.9" stroke-linecap="round"/></symbol>
  <symbol id="i-na" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7.5" fill="currentColor"/><path d="M4.5 8h7" stroke="#fff" stroke-width="2" stroke-linecap="round"/></symbol>
  <symbol id="i-stale" viewBox="0 0 16 16"><rect x=".5" y=".5" width="15" height="15" rx="4" fill="currentColor"/><path d="M8 3.8V8l3 2" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-added" viewBox="0 0 16 16"><rect x=".5" y=".5" width="15" height="15" rx="2" fill="currentColor"/><path d="M8 4v8M4 8h8" stroke="#fff" stroke-width="1.9" stroke-linecap="round"/></symbol>
  <symbol id="i-removed" viewBox="0 0 16 16"><rect x=".5" y=".5" width="15" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4 8h8" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
  <symbol id="i-changed" viewBox="0 0 16 16"><path d="M8 .6l7.4 7.4L8 15.4.6 8z" fill="currentColor"/><path d="M5.3 8h5.4M8.6 5.9 10.7 8l-2.1 2.1" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-passed" viewBox="0 0 16 16"><path d="M8 .5l6.5 2.4v4.6c0 4-2.8 6.9-6.5 8-3.7-1.1-6.5-4-6.5-8V2.9z" fill="currentColor"/><path d="M4.8 8.1l2.2 2.3 4.2-4.6" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-failed" viewBox="0 0 16 16"><path d="M8 .5l6.5 2.4v4.6c0 4-2.8 6.9-6.5 8-3.7-1.1-6.5-4-6.5-8V2.9z" fill="currentColor"/><path d="M5.6 5.6l4.8 4.8M10.4 5.6l-4.8 4.8" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/></symbol>
  <symbol id="i-none" viewBox="0 0 16 16"><path d="M8 .5l6.5 2.4v4.6c0 4-2.8 6.9-6.5 8-3.7-1.1-6.5-4-6.5-8V2.9z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M5 8h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
</svg>
{% endmacro %}

{% macro icon(name) %}<svg class="icon" aria-hidden="true"><use href="#i-{{ name }}"/></svg>{% endmacro %}

{#- A verdict as icon plus word. -#}
{% macro verdict(value) %}{% set style = VERDICTS[value] %}<span class="status status-{{ style.css }}">{{ icon(style.css) }}{{ style.label }}</span>{% endmacro %}

{#- A gate (GateView) as icon plus word. -#}
{% macro gate(view, extra_class="") %}<span class="status gate-{{ view.state }}{{ ' ' ~ extra_class if extra_class }}">{{ icon(view.state if view.state in ("passed", "failed") else "none") }}{{ view.text }}</span>{% endmacro %}

{% macro head(title) %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{ meta.generator }}">
<title>{{ title }}</title>
<style>
{{ style }}
</style>
</head>
{% endmacro %}

{% macro footer(meta) %}
<footer>
{{ caller() }}  <p>Generated by {{ meta.generator }} on {{ format_time(meta.generated_at) }} from results contract v1.</p>
  <p>The report never includes the rendered suite configuration or any key material; text taken from results files is filtered for private keys and credentials.</p>
</footer>
{% endmacro %}
