{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inji-conformance:schema:run-manifest:v1",
  "title": "Run manifest, version 1",
  "description": "manifest.json at the top of a run folder (${HARNESS_RUN_DIR}/reports/<run id>/). It records what ran, on which code and images, how long each plan took and where each component's results.json is, so a report or a diff between two runs can name exactly what changed.",
  "type": "object",
  "required": ["schema_version", "run_id", "mode", "track", "started_at", "harness", "components", "gate"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"$ref": "urn:inji-conformance:schema:results:v1#/$defs/run_id"},
    "mode": {
      "description": "component: one component (run-conformance.sh --component). combined: both components in one run.",
      "enum": ["component", "combined"]
    },
    "track": {"enum": ["gate", "haip"]},
    "parallel": {"type": "boolean", "description": "true when the components' plans ran at the same time."},
    "started_at": {"$ref": "urn:inji-conformance:schema:results:v1#/$defs/timestamp"},
    "finished_at": {"$ref": "urn:inji-conformance:schema:results:v1#/$defs/timestamp"},
    "wall_time_s": {"type": "number", "minimum": 0},
    "command": {
      "description": "The command line that started the run, one argument per item.",
      "type": "array",
      "items": {"type": "string"}
    },
    "harness": {
      "type": "object",
      "required": ["git_commit"],
      "additionalProperties": false,
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "git_dirty": {"type": "boolean", "description": "true when the working tree had uncommitted changes."},
        "runner_version": {"type": "string", "minLength": 1}
      }
    },
    "suite": {
      "type": "object",
      "required": ["base_url", "version"],
      "additionalProperties": false,
      "properties": {
        "base_url": {"$ref": "urn:inji-conformance:schema:results:v1#/$defs/http_url"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "images": {
      "description": "Every container image the run used, as Docker resolved it.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service", "image", "digest"],
        "additionalProperties": false,
        "properties": {
          "service": {"type": "string", "minLength": 1},
          "image": {"type": "string", "minLength": 1},
          "digest": {"$ref": "urn:inji-conformance:schema:results:v1#/$defs/digest", "description": "Registry digest the image was pulled by; null for an image built locally or not pulled by digest."},
          "commit": {"$ref": "urn:inji-conformance:schema:results:v1#/$defs/commit", "description": "Source commit from the image's labels, when it has one."}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "plan", "results"],
        "additionalProperties": false,
        "properties": {
          "component": {"$ref": "urn:inji-conformance:schema:results:v1#/$defs/component"},
          "plan": {"type": "string", "minLength": 1},
          "results": {"$ref": "urn:inji-conformance:schema:results:v1#/$defs/relative_path", "description": "That component's results.json, relative to the run folder."},
          "started_at": {"$ref": "urn:inji-conformance:schema:results:v1#/$defs/timestamp"},
          "finished_at": {"$ref": "urn:inji-conformance:schema:results:v1#/$defs/timestamp"},
          "wall_time_s": {"type": "number", "minimum": 0},
          "exit_code": {"enum": [0, 1, 2, 3, 4]}
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["passed", "exit_code"],
      "additionalProperties": false,
      "properties": {
        "passed": {"type": "boolean"},
        "exit_code": {"enum": [0, 1, 2, 3, 4]}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Facts about the machine, for example os, docker and python versions."
    },
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
